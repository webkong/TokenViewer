<UserControl x:Class="TokenViewerWindows.Views.HeatmapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TokenViewerWindows.Views">
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <TextBlock Text="{views:L10n usageActivity}" Style="{StaticResource CardTitle}" />
        <TextBlock x:Name="ActiveDaysLabel" DockPanel.Dock="Right" Style="{StaticResource MutedLabel}" />
      </DockPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <UniformGrid x:Name="CellGrid" Rows="7" Columns="53" HorizontalAlignment="Left" />
      </ScrollViewer>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
        <TextBlock Text="{views:L10n heatmapLess}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
        <Border Width="10" Height="10" CornerRadius="2" Background="#374151" Margin="1.5" />
        <Border Width="10" Height="10" CornerRadius="2" Background="#59059669" Margin="1.5" />
        <Border Width="10" Height="10" CornerRadius="2" Background="#8C059669" Margin="1.5" />
        <Border Width="10" Height="10" CornerRadius="2" Background="#C7059669" Margin="1.5" />
        <Border Width="10" Height="10" CornerRadius="2" Background="#059669" Margin="1.5" />
        <TextBlock Text="{views:L10n heatmapMore}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="4,0,0,0" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
