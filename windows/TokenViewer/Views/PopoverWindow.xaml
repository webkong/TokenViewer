<Window x:Class="TokenViewerWindows.Views.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TokenViewerWindows.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="420"
        Height="680">
  <Window.Resources>
    <views:TokensConverter x:Key="Tokens" />
    <views:MergedModelsConverter x:Key="MergedModels" />
    <views:InverseBoolConverter x:Key="InverseBool" />
    <views:AgentNameConverter x:Key="AgentName" />
    <views:CountdownConverter x:Key="Countdown" />
    <views:FilterVisibleLimitsConverter x:Key="FilterVisibleLimits" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Border Background="{StaticResource WindowBg}"
          BorderBrush="{StaticResource PanelBorder}"
          BorderThickness="1"
          CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <DockPanel Grid.Row="0" Margin="14,10">
        <TextBlock Text="{views:L10n appName}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="↻" ToolTip="{views:L10n syncNow}" Click="OnSyncClick"
                  IsEnabled="{Binding Shell.Sync.IsSyncing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                  Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedText}" Padding="6,2" />
          <Button Content="⚙" ToolTip="{views:L10n settings}" Click="OnSettingsClick"
                  Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedText}" Padding="6,2" />
        </StackPanel>
      </DockPanel>

      <!-- Content -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,4,14,6">
          <!-- 2x2 summary cards -->
          <ItemsControl ItemsSource="{Binding PanelCards}"
                        Visibility="{Binding Shell.Settings.PanelShowSummary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="3">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Mini trend -->
          <views:TrendChartControl ItemsSource="{Binding DailyUsage}"
                                   IsHourly="{Binding IsHourlyView}"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding Shell.Settings.PanelShowTrend, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

          <!-- Compact heatmap -->
          <views:HeatmapControl ItemsSource="{Binding Heatmap}" Weeks="16" Margin="0,10,0,0"
                                Visibility="{Binding Shell.Settings.PanelShowHeatmap, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

          <!-- Top models -->
          <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                  Visibility="{Binding Shell.Settings.PanelShowModels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="{views:L10n topModels}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding ModelBreakdown, Converter={StaticResource MergedModels}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Tokens, Converter={StaticResource Tokens}}"
                                 FontSize="10" Foreground="{StaticResource MutedText}" />
                      <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Compact limits (filtered by LimitsVisibleSources) -->
          <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                  Visibility="{Binding Shell.Settings.PanelShowLimits, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="{views:L10n limits}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
              <ItemsControl>
                <ItemsControl.ItemsSource>
                  <MultiBinding Converter="{StaticResource FilterVisibleLimits}">
                    <Binding Path="Shell.Limits.ActiveAgents" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="Shell.Settings.LimitsVisibleSources" RelativeSource="{RelativeSource AncestorType=Window}" />
                  </MultiBinding>
                </ItemsControl.ItemsSource>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <DockPanel>
                        <TextBlock Text="{Binding Name, Converter={StaticResource AgentName}}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource MutedText}"
                                   Text="{Binding Windows[0].UsedPercent, StringFormat={}{0:0}%, TargetNullValue=—}" />
                      </DockPanel>
                      <DockPanel>
                        <TextBlock Text="{Binding PlanLabel}" FontSize="9" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock DockPanel.Dock="Right" FontSize="9" Foreground="{StaticResource MutedText}">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource Countdown}">
                              <Binding Path="DisplayResetAt" />
                              <Binding Path="Shell.Limits.Now" RelativeSource="{RelativeSource AncestorType=Window}" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </DockPanel>
                      <TextBlock Text="{Binding Error}" FontSize="9" Foreground="#FCA5A5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <DockPanel Grid.Row="2" Margin="14,6,14,10">
        <Button Content="{views:L10n dashboard}" Click="OnDashboardClick"
                Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brand}" Padding="4,2" />
        <Button DockPanel.Dock="Right" Content="{views:L10n quit}" Click="OnQuitClick"
                Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedText}" Padding="4,2" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
