<UserControl x:Class="TokenViewerWindows.Views.LimitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TokenViewerWindows.Views">
  <UserControl.Resources>
    <views:AgentNameConverter x:Key="AgentName" />
    <views:BrandColorConverter x:Key="BrandColor" />
    <views:CountdownConverter x:Key="Countdown" />
    <views:InverseBoolConverter x:Key="InverseBool" />
    <views:WidthToColumnsConverter x:Key="WidthToColumns" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,16,0,0">

      <!-- Header -->
      <DockPanel Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="{views:L10n limitsTitle}" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="{views:L10n limitsSubtitle}" Foreground="{StaticResource MutedText}" FontSize="12" />
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="{views:L10n refreshLimits}"
                Padding="14,8" Background="{StaticResource Brand}" BorderThickness="0" Foreground="White" FontWeight="SemiBold"
                Click="OnRefreshClick" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
      </DockPanel>

      <!-- Loading -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
        <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{views:L10n loading}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Active agents -->
      <ItemsControl ItemsSource="{Binding ActiveAgents}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthToColumns}}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding Name, Converter={StaticResource BrandColor}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name, Converter={StaticResource AgentName}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#1F2937" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PlanLabel}" FontSize="10" Foreground="{StaticResource MutedText}" />
                    </Border>
                  </StackPanel>
                  <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource MutedText}" VerticalAlignment="Center">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource Countdown}">
                        <Binding Path="DisplayResetAt" />
                        <Binding Path="DataContext.Now" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Windows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,8">
                        <DockPanel>
                          <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource MutedText}" />
                          <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercent, StringFormat={}{0:0}%}" FontSize="11" FontWeight="SemiBold" />
                        </DockPanel>
                        <ProgressBar Height="5" Maximum="100" Value="{Binding UsedPercent}"
                                     Foreground="{StaticResource Brand}" Background="#243244" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#FCA5A5" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Inactive agents -->
      <TextBlock Text="{views:L10n notConfigured}" Style="{StaticResource CardTitle}" Margin="0,4,0,8" />
      <ItemsControl ItemsSource="{Binding InactiveAgents}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthToColumns}}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="10" Height="10" Fill="{Binding Name, Converter={StaticResource BrandColor}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding Name, Converter={StaticResource AgentName}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Empty state -->
      <Border Padding="32" Margin="0,8,0,0">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Agents.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{views:L10n noLimitsData}" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
