<UserControl x:Class="TokenViewerWindows.Views.TrendChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TokenViewerWindows.Views">
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <TextBlock Text="{views:L10n usageTrend}" Style="{StaticResource CardTitle}" />
        <TextBlock x:Name="GranularityLabel" DockPanel.Dock="Right" Style="{StaticResource MutedLabel}" />
      </DockPanel>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="LeftAxis" Grid.Column="0" VerticalAlignment="Stretch" Width="42" />

        <Grid Grid.Column="1" ClipToBounds="True">
          <Canvas x:Name="PlotCanvas" Height="160" Background="Transparent"
                  SizeChanged="OnPlotSizeChanged"
                  MouseMove="OnPlotMouseMove"
                  MouseLeave="OnPlotMouseLeave">
            <Canvas x:Name="PlotSeries" />
            <Line x:Name="Crosshair" X1="0" Y1="0" X2="0" Y2="160"
                  Stroke="#6694A3B8" StrokeThickness="1" StrokeDashArray="3,3"
                  Visibility="Collapsed" />
            <Border x:Name="TooltipPanel" Background="#0B1220" CornerRadius="8"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Padding="8" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="TooltipTitle" FontSize="10" FontWeight="Bold" />
                <TextBlock x:Name="TooltipInput" FontSize="9" Foreground="{StaticResource MutedText}" />
                <TextBlock x:Name="TooltipOutput" FontSize="9" Foreground="{StaticResource MutedText}" />
                <TextBlock x:Name="TooltipCache" FontSize="9" Foreground="{StaticResource MutedText}" />
                <TextBlock x:Name="TooltipCost" FontSize="9" Foreground="{StaticResource MutedText}" />
                <TextBlock x:Name="TooltipHit" FontSize="9" Foreground="{StaticResource CacheReadBrush}" />
              </StackPanel>
            </Border>
          </Canvas>
        </Grid>

        <StackPanel x:Name="RightAxis" Grid.Column="2" VerticalAlignment="Stretch" Width="42" />
      </Grid>

      <StackPanel x:Name="XAxis" Orientation="Horizontal" Margin="42,4,42,0" />
    </StackPanel>
  </Border>
</UserControl>
