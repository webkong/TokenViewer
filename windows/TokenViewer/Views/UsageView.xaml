<UserControl x:Class="TokenViewerWindows.Views.UsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TokenViewerWindows.Views">
  <UserControl.Resources>
    <views:TokensConverter x:Key="Tokens" />
    <views:CostConverter x:Key="Cost" />
    <views:RangeTitleConverter x:Key="RangeTitle" />
    <views:InverseBoolConverter x:Key="InverseBool" />
    <views:IsCustomRangeToVisibilityConverter x:Key="IsCustomRange" />
    <views:NullToVisibilityConverter x:Key="NullToVis" />
    <views:TokenSegmentsConverter x:Key="TokenSegments" />
    <views:CacheHitRateConverter x:Key="CacheHit" />
    <views:MergedModelsConverter x:Key="MergedModels" />
    <views:AgentRollupConverter x:Key="AgentRollup" />
    <views:DailyRowsConverter x:Key="DailyRows" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="RangeItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="16" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,16,0,0">

      <!-- Header -->
      <DockPanel Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="{views:L10n usageTitle}" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="{views:L10n usageSubtitle}" Foreground="{StaticResource MutedText}" FontSize="12" />
        </StackPanel>
        <Button DockPanel.Dock="Right"
                Content="{views:L10n syncNow}"
                Padding="16,10"
                Background="{StaticResource Brand}"
                BorderThickness="0"
                Foreground="White"
                FontWeight="SemiBold"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                Command="{Binding DataContext.Main.SyncCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
      </DockPanel>

      <!-- Loading indicator -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
        <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{views:L10n loading}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Sync error / status bar -->
      <Border Background="#3F1D1D" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
              Visibility="{Binding DataContext.Sync.Error, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVis}}">
        <TextBlock Text="{Binding DataContext.Main.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                   Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" />
      </Border>

      <!-- Range selector + custom dates -->
      <DockPanel Margin="0,0,0,16">
        <ListBox x:Name="RangeList"
                 SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RangeItem}" />
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource RangeTitle}}" FontSize="12" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="{Binding SelectedRange, Converter={StaticResource IsCustomRange}}">
          <TextBlock Text="{views:L10n rangeFrom}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <DatePicker SelectedDate="{Binding CustomFrom, Mode=TwoWay}" Margin="0,0,8,0" />
          <TextBlock Text="{views:L10n rangeTo}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <DatePicker SelectedDate="{Binding CustomTo, Mode=TwoWay}" />
        </StackPanel>
      </DockPanel>

      <Grid>
        <!-- Empty state -->
        <Border Padding="32" VerticalAlignment="Top">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Summary}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{views:L10n noUsageData}" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" />
        </Border>

        <!-- Dashboard -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Summary}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <!-- Metric cards -->
          <UniformGrid Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{views:L10n usageTotalTokens}" Style="{StaticResource MutedLabel}" />
                <TextBlock Text="{Binding Summary.TotalTokens, Converter={StaticResource Tokens}}" FontSize="22" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0">
              <Border.ToolTip>
                <ToolTip>
                  <StackPanel>
                    <TextBlock Text="{views:L10n costByModel}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ModelBreakdown, Converter={StaticResource MergedModels}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Width="240">
                            <TextBlock Text="{Binding Cost, Converter={StaticResource Cost}}" DockPanel.Dock="Right" FontSize="12" />
                            <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ToolTip>
              </Border.ToolTip>
              <StackPanel>
                <TextBlock Text="{views:L10n cost}" Style="{StaticResource MutedLabel}" />
                <TextBlock Text="{Binding Summary.TotalCostUsd, Converter={StaticResource Cost}}" FontSize="22" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{views:L10n usageConversations}" Style="{StaticResource MutedLabel}" />
                <TextBlock Text="{Binding Summary.ConversationCount}" FontSize="22" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
              <StackPanel>
                <TextBlock Text="{views:L10n usageActiveDaysTitle}" Style="{StaticResource MutedLabel}" />
                <TextBlock Text="{Binding Summary.ActiveDays}" FontSize="22" FontWeight="Bold" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Token type breakdown -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <TextBlock Text="{views:L10n usageTokenBreakdown}" Style="{StaticResource CardTitle}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Summary, Converter={StaticResource CacheHit}}"
                           Style="{StaticResource MutedLabel}" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Summary, Converter={StaticResource TokenSegments}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                      <Ellipse Width="7" Height="7" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,4,0" />
                      <TextBlock Text="{Binding Label}" Style="{StaticResource MutedLabel}" />
                      <TextBlock Text="{Binding Tokens, Converter={StaticResource Tokens}}" FontSize="11" Margin="4,0,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Trend chart -->
          <views:TrendChartControl ItemsSource="{Binding DailyUsage}"
                                   IsHourly="{Binding IsHourlyView}"
                                   Margin="0,0,0,12" />

          <!-- Heatmap -->
          <views:HeatmapControl ItemsSource="{Binding Heatmap}"
                                Margin="0,0,0,12" />

          <!-- Breakdowns: agent + model -->
          <WrapPanel Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" MinWidth="460" Margin="0,0,12,12">
              <StackPanel>
                <TextBlock Text="{views:L10n usageAgents}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding ModelBreakdown, Converter={StaticResource AgentRollup}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <DockPanel>
                          <TextBlock Text="{Binding Cost, Converter={StaticResource Cost}}" DockPanel.Dock="Right" Style="{StaticResource MutedLabel}" />
                          <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Height="5" Maximum="100" Value="{Binding Percentage}"
                                     Foreground="{StaticResource Brand}" Background="#243244" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" MinWidth="460" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{views:L10n usageModels}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding ModelBreakdown, Converter={StaticResource MergedModels}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <DockPanel>
                          <TextBlock Text="{Binding Cost, Converter={StaticResource Cost}}" DockPanel.Dock="Right" Style="{StaticResource MutedLabel}" />
                          <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Height="5" Maximum="100" Value="{Binding Percentage}"
                                     Foreground="{StaticResource Brand}" Background="#243244" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </WrapPanel>

          <!-- Daily details table -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{views:L10n usageDailyDetails}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{views:L10n usageColDate}" Style="{StaticResource MutedLabel}" />
                <TextBlock Grid.Column="1" Text="{views:L10n usageColTotal}" Style="{StaticResource MutedLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{views:L10n usageColInput}" Style="{StaticResource MutedLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{views:L10n usageColOutput}" Style="{StaticResource MutedLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{views:L10n usageColCache}" Style="{StaticResource MutedLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{views:L10n usageColConvs}" Style="{StaticResource MutedLabel}" TextAlignment="Right" />
              </Grid>
              <Separator Margin="0,6" Background="{StaticResource PanelBorder}" />
              <ItemsControl ItemsSource="{Binding DailyUsage, Converter={StaticResource DailyRows}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="56" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Date}" FontSize="12" Foreground="{StaticResource MutedText}" />
                      <TextBlock Grid.Column="1" Text="{Binding Point.TotalTokens, Converter={StaticResource Tokens}, TargetNullValue=—}" FontSize="12" TextAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding Point.InputTokens, Converter={StaticResource Tokens}, TargetNullValue=—}" FontSize="12" TextAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="{Binding Point.OutputTokens, Converter={StaticResource Tokens}, TargetNullValue=—}" FontSize="12" TextAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="{Binding Point.CachedInputTokens, Converter={StaticResource Tokens}, TargetNullValue=—}" FontSize="12" TextAlignment="Right" />
                      <TextBlock Grid.Column="5" Text="{Binding Point.ConversationCount, TargetNullValue=—}" FontSize="12" TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
