<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TokenViewerWindows</RootNamespace>
    <AssemblyName>TokenViewer</AssemblyName>
    <ApplicationIcon>Resources\TokenViewer.ico</ApplicationIcon>
    <CoreRustTarget Condition="'$(CoreRustTarget)' == ''">x86_64-pc-windows-msvc</CoreRustTarget>
    <CoreDllName>tokenviewer_core.dll</CoreDllName>
  </PropertyGroup>

  <!-- The WindowsDesktop SDK (UseWPF/UseWindowsForms) drops System.IO and
       System.Net.Http from the default ImplicitUsings set. Restore them as
       global usings so the existing services (SettingsStore, UpdateService,
       LimitsService) and CoreBridge resolve Path/File/Directory/HttpClient. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <!-- Brand + app icon assets: embed as WPF Resource so they ship in the
       publish output; remove them from the default None glob first. -->
  <ItemGroup>
    <None Remove="Resources\**\*.png" />
    <None Remove="Resources\**\*.ico" />
    <Resource Include="Resources\**\*.png" />
    <Resource Include="Resources\**\*.ico" />
  </ItemGroup>

  <Target Name="CopyRustCoreToOutput" AfterTargets="Build;Publish">
    <PropertyGroup>
      <CoreDllPath>$(MSBuildProjectDirectory)\..\..\core\target\$(CoreRustTarget)\release\$(CoreDllName)</CoreDllPath>
    </PropertyGroup>
    <Copy SourceFiles="$(CoreDllPath)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(CoreDllPath)') and Exists('$(TargetDir)')" />
  </Target>
</Project>
